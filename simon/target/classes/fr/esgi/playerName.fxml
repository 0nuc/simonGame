<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" minHeight="1085.0" minWidth="1500.0" spacing="20.0"
    style="-fx-background-color: #463F3F;" xmlns="http://javafx.com/javafx/23.0.1"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.esgi.controller.PlayerNameController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Button fx:id="btnRetour" layoutX="961.0" layoutY="967.0" mnemonicParsing="false"
                prefHeight="74.0" prefWidth="160.0"
                style="-fx-background-color: none; -fx-border-color: white; -fx-border-width: 2px; -fx-border-radius: 10;"
                text="RETOUR" textFill="WHITE">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Button>
        <Button fx:id="btnSuivant" layoutX="1159.0" layoutY="967.0" mnemonicParsing="false"
                prefHeight="74.0" prefWidth="160.0"
                style="-fx-background-color: none; -fx-border-color: white; -fx-border-width: 2px; -fx-border-radius: 10;"
                text="SUIVANT" textFill="WHITE">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Button>
        <AnchorPane prefHeight="1084.0" prefWidth="1460.0">
            <children>
                <Label alignment="TOP_LEFT" contentDisplay="TOP" layoutX="18.0" layoutY="5.0"
                    text="MULTIJOUEUER" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="96.0" />
                    </font>
                </Label>
                <Label alignment="TOP_LEFT" contentDisplay="TOP" layoutX="23.0" layoutY="116.0"
                    text="ENTRER VOTRE NOM" textFill="WHITE">
                    <font>
                        <Font size="29.0" />
                    </font>
                </Label>
                <VBox fx:id="playerNameFields" layoutX="38.0" layoutY="291.0" spacing="10.0">
                    <!-- Les champs de texte seront ajoutés ici dynamiquement -->
                </VBox>

            </children>
        </AnchorPane>
    </children>
</VBox>