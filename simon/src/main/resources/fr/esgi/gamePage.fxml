<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="1085.0" prefWidth="1500.0" spacing="20"
   style="-fx-background-color: #463F3F;" xmlns="http://javafx.com/javafx/23.0.1"
   xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.esgi.controller.GameController">

   <children>
      <AnchorPane prefHeight="1084.0" prefWidth="1460.0">
         <children>
            <!-- Titre -->
            <Label alignment="TOP_LEFT" layoutX="18.0" layoutY="5.0"
               style="-fx-font-size: 96px; -fx-font-weight: bold;" text="A VOUS DE JOUER"
               textFill="WHITE" />

            <!-- Sous-titre -->
            <Label alignment="TOP_LEFT" layoutX="23.0" layoutY="116.0" style="-fx-font-size: 29px;"
               text="AMUSEZ VOUS BIEN !!" textFill="WHITE" />

            <!-- Onglet de configuration -->
            <AnchorPane layoutX="35.0" layoutY="169.0" prefHeight="658.0" prefWidth="400"
               style="-fx-background-color: #2D2828; -fx-border-color: white; -fx-border-width: 3; -fx-border-radius: 30; -fx-background-radius: 30;">

               <children>
                  <Label layoutX="20" layoutY="10"
                     style="-fx-font-size: 30px; -fx-font-weight: bold;" text="OPTION :"
                     textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="27.0" />
                     </font>
                  </Label>

                  <Label layoutX="20.0" layoutY="64.0" text="Couleur carré 1" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="colorRed" layoutX="150.0" layoutY="59.0" prefWidth="100" />

                  <Label layoutX="20.0" layoutY="118.0" text="Couleur carée 2" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="colorBlue" layoutX="150.0" layoutY="113.0" prefWidth="100" />

                  <Label layoutX="20.0" layoutY="172.0" text="Couleur carré 3:" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="colorGreen" layoutX="150.0" layoutY="167.0" prefWidth="100" />

                  <Label layoutX="20.0" layoutY="225.0" text="Couleur carée 4:" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="colorYellow" layoutX="150.0" layoutY="220.0" prefWidth="100" />

                  <Label layoutX="20.0" layoutY="295.0" text="Son des touches :" textFill="WHITE">
                     <font>
                        <Font name="System Italic" size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="soundChoice" layoutX="150.0" layoutY="290.0" prefWidth="150" />

                  <Button fx:id="btnApplyConfig" layoutX="56.0" layoutY="348.0" prefHeight="27.0"
                     prefWidth="288.0"
                     style="-fx-background-color: none; -fx-border-color: #fff; -fx-border-radius: 5;"
                     text="Appliquer" textFill="WHITE">
                     <font>
                        <Font size="23.0" />
                     </font>
                  </Button>

                  <!-- Bouton "START" -->
                  <Button fx:id="btnStart" layoutX="56.0" layoutY="408.0" mnemonicParsing="false"
                     prefHeight="51.0" prefWidth="288.0"
                     style="-fx-background-color: #463F3F; -fx-border-radius: 50; -fx-font-size: 24px; -fx-font-weight: bold;"
                     text="START" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="32.0" />
                     </font>
                  </Button>

                  <!-- Affichage du score -->
                  <Label fx:id="lblScore" layoutX="56.0" layoutY="481.0" prefHeight="35.0"
                     prefWidth="288.0" style="-fx-font-size: 24px; -fx-background-color: #463F3F;"
                     text="Score: 0" textFill="WHITE" />
               </children>
            </AnchorPane>

            <!-- Bouton "Rejouer" -->
            <Button fx:id="btnRestart" layoutX="76.0" layoutY="696.0" mnemonicParsing="false"
               prefHeight="51.0" prefWidth="317.0"
               style="-fx-background-color: #463F3F; -fx-border-radius: 30; -fx-font-size: 24px;"
               text="REJOUER" textFill="WHITE" visible="false" />
            <Button fx:id="btnReplayBest" layoutX="76.0" layoutY="756.0" mnemonicParsing="false"
               prefHeight="43.0" prefWidth="317.0"
               style="-fx-background-color: #463F3F; -fx-border-radius: 30; -fx-font-size: 24px;"
               text="Rejouer Meilleur" textFill="WHITE" visible="false" />

            <!-- Boutons de couleurs -->
            <Button fx:id="btnRed" layoutX="602.0" layoutY="214.0" mnemonicParsing="false"
               prefHeight="256.0" prefWidth="256.0" />

            <Button fx:id="btnBlue" layoutX="946.0" layoutY="214.0" mnemonicParsing="false"
               prefHeight="256.0" prefWidth="256.0" />

            <Button fx:id="btnGreen" layoutX="602.0" layoutY="556.0" mnemonicParsing="false"
               prefHeight="256.0" prefWidth="256.0" />

            <Button fx:id="btnYellow" layoutX="946.0" layoutY="556.0" mnemonicParsing="false"
               prefHeight="256.0" prefWidth="256.0" />

         </children>
      </AnchorPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>