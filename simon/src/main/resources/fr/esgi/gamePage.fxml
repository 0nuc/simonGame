<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
   alignment="CENTER" spacing="20" prefWidth="1500.0" prefHeight="1085.0"
   style="-fx-background-color: #463F3F;" fx:controller="fr.esgi.controller.GameController">

   <children>
      <AnchorPane prefHeight="1084.0" prefWidth="1460.0">
         <children>
            <!-- Titre -->
            <Label alignment="TOP_LEFT" layoutX="18.0" layoutY="5.0"
               text="A VOUS DE JOUER" textFill="WHITE"
               style="-fx-font-size: 96px;" />

            <!-- Sous-titre -->
            <Label alignment="TOP_LEFT" layoutX="23.0" layoutY="116.0"
               text="AMUSEZ VOUS BIEN !!" textFill="WHITE"
               style="-fx-font-size: 29px;" />

            <!-- Boutons de couleurs -->
            <Button fx:id="btnRed" layoutX="602.0" layoutY="214.0"
               mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0"
               style="-fx-background-color: #480E0E;" />

            <Button fx:id="btnBlue" layoutX="1002.0" layoutY="214.0"
               mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0"
               style="-fx-background-color: #11164F;" />

            <Button fx:id="btnGreen" layoutX="602.0" layoutY="612.0"
               mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0"
               style="-fx-background-color: #0C5C15;" />

            <Button fx:id="btnYellow" layoutX="1002.0" layoutY="612.0"
               mnemonicParsing="false" prefHeight="200.0" prefWidth="200.0"
               style="-fx-background-color: #88840A;" />

            <!-- Bouton "START" -->
            <Button fx:id="btnStart" layoutX="33.0" layoutY="695.0"
               mnemonicParsing="false" prefHeight="51.0" prefWidth="317.0"
               style="-fx-background-color: #463F3F; -fx-border-radius: 30; -fx-font-size: 24px;"
               text="START" textFill="WHITE" />

            <!-- Bouton "Rejouer" -->
            <Button fx:id="btnRestart" layoutX="33.0" layoutY="760.0"
               mnemonicParsing="false" prefHeight="51.0" prefWidth="317.0"
               style="-fx-background-color: #555555; -fx-border-radius: 30; -fx-font-size: 24px;"
               text="REJOUER" textFill="WHITE" visible="false" />

            <!-- Affichage du score -->
            <Label fx:id="lblScore" layoutX="50.0" layoutY="300.0"
               text="Score: 0" textFill="WHITE"
               style="-fx-font-size: 24px;" />
         </children>
      </AnchorPane>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>